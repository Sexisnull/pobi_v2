# =====================================================================
# PoBi v2 环境变量模板（.env.example）
# ---------------------------------------------------------------------
# 使用：复制为 .env 后按需修改。start-prod.sh 在缺失 .env 时会自动
# 生成一份（含随机 JWT_SECRET 与 POBI_V2_TOKEN_ENCRYPTION_KEY）。
# 本文件随仓库提交，便于他人一键 docker 化部署。
# =====================================================================

# ---- 必填：LLM 凭证（按 provider 填写，DeadEndAgent 运行时解析）----
# 至少填一个，否则 agent 无法工作。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ---- 数据库（compose 内部网络域名：db）----
POBI_V2_DB_HOST=db
POBI_V2_DB_PORT=5432
POBI_V2_DB_USER=pobi
POBI_V2_DB_PASSWORD=pobi
POBI_V2_DB_NAME=pobi_v2

# ---- Redis（arq 任务队列，compose 内部域名：redis）----
REDIS_URL=redis://redis:6379/0

# ---- Web 平台 ----
# 留空时 start-prod.sh 会自动生成随机值
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- API 令牌（PAT）加密密钥 ----
# 留空时令牌仍可创建/校验，但创建后无法「点击查看」明文（仅创建时一次性可见）。
# start-prod.sh 会为其自动生成随机值（openssl rand -hex 32）。
POBI_V2_TOKEN_ENCRYPTION_KEY=

# ---- 前端访问地址（nginx 反代 /api 用，默认同宿主域名即可）----
POBI_V2_API_BASE=http://localhost/api/v1

# ---- 容器镜像仓库前缀（兼容老内网 registry）----
# 一键本地构建时留空即可（使用 compose 内 build 上下文）；
# 使用内网 ACR 时改为 registry.cn-xxx.aliyuncs.com/pobi/
ACR_REGISTRY=

# ---- 预构建全量镜像（推荐给他人部署）----
# 留空 = 本地 build pobi_v2:1.0.0；
# 填入已推送镜像则 start-prod.sh 优先 pull，避免本地构建网络失败。
# 示例（阿里云 ACR 个人版公开仓库）：
# POBI_IMAGE=crpi-9ztkvcvf31ip1h4c.cn-hangzhou.personal.cr.aliyuncs.com/pobi/pobi_v2:1.0.0
POBI_IMAGE=

# ---- 全面容器化：Kali 沙箱（compose 常驻 pobi_kali，DooD 复用宿主机 daemon）----
# 一般无需修改；仅自定义镜像源时调整
KALI_IMAGE=xoxruns/sandboxed_kali:latest
POBI_V2_SANDBOX_NETWORK=pobi_net
POBI_V2_KALI_CONTAINER_NAME=pobi_kali
