# Pobi v2 生产镜像 —— 多阶段构建（AGENTS.md 强制要求）
# 彻底隔离编译工具与纯净运行时，极限压缩镜像体积。

# ---------- 阶段 1：构建器 ----------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

# 系统级构建依赖（仅用于编译器阶段，运行时剔除）
# 构建期换用国内镜像源以绕过 deb.debian.org 偶发 502
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

# 先用 uv 解析并安装全部依赖到隔离前缀（含 Playwright/tree-sitter 等编译型包）
RUN pip install --no-cache-dir uv
COPY pyproject.toml README.md ./
RUN uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache .

# ---------- 阶段 2：运行时 ----------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

WORKDIR /app

# 运行时系统库：
# - curl / postgresql-client：健康检查与 DB 运维
# - docker.io：docker CLI（DooD 需要），api/worker 经挂载的 /var/run/docker.sock
#   复用宿主机 Docker daemon 连接全局共享 Kali 容器（无需容器内跑 daemon）
# - ripgrep：ripgrepy 调用的系统二进制（AVFS 代码搜索能力，开箱即用）
# - 浏览器系统依赖：Playwright / pydoll 浏览器自动化的 chromium 运行库（开箱即用）
# 构建期换用国内镜像源（deb.debian.org 容器内访问偶发 502 Bad Gateway），
# 确保 apt-get 稳定可用；运行时不再依赖源，无需还原。
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl postgresql-client docker.io ripgrep tzdata \
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
        libdrm2 libdbus-1-3 libxkbcommon0 libxcomposite1 libxdamage1 \
        libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
        libatspi2.0-0 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# 时区统一为中国标准时间（Asia/Shanghai），使容器日志时间戳与本地一致
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# 浏览器二进制固化进镜像：Playwright + pydoll 均依赖 chromium，随镜像预装，
# 用户无需任何后装即获得完整浏览器自动化 / 认证解析 / Web 资源提取能力。
# PLAYWRIGHT_BROWSERS_PATH=0 将浏览器装到 venv 内，避免依赖外部路径。
ENV PLAYWRIGHT_BROWSERS_PATH=0

# 从构建器复制纯净的虚拟环境（必须在 playwright install 之前，否则 /opt/venv 不存在）
COPY --from=builder /opt/venv /opt/venv

# venv 就位后再安装 chromium 浏览器二进制
RUN /opt/venv/bin/python -m playwright install --with-deps chromium

# Pydoll 默认只检索系统路径（如 /usr/bin/google-chrome），不读取 PLAYWRIGHT_BROWSERS_PATH。
# 将 Playwright 预装的完整 chromium 软链到系统路径，使 Pydoll 无需显式 binary_location 即可启动。
# 使用通配避免 chromium 版本号变化时断裂；仅链接完整 chromium（非 headless_shell），
# 因 headless_shell 在 CDP 交互上支持不全，会导致 pydoll 部分 API 失效。
RUN CHROME_BIN=$(ls -d /opt/venv/lib/*/site-packages/playwright/driver/package/.local-browsers/chromium-*/chrome-linux/chrome 2>/dev/null | head -1) \
    && if [ -n "$CHROME_BIN" ]; then ln -sf "$CHROME_BIN" /usr/bin/google-chrome; fi \
    && ln -sf /usr/bin/google-chrome /usr/bin/google-chrome-stable 2>/dev/null || true

# 复制应用源码（含内嵌 pobi_agent / pobi_prompts / web）
COPY pobi_v2 ./pobi_v2
COPY pobi_agent ./pobi_agent
COPY pobi_prompts ./pobi_prompts
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY web ./web

# 健康检查（API 就绪）
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 默认启动 API（worker 通过 command 覆盖）
# 依赖仅含 uvicorn（无 gunicorn），直接用 uvicorn 拉起 ASGI 应用
# 注：uvicorn CLI 无 --timeout 参数（那是 gunicorn 的），超时由应用层/反向代理控制
EXPOSE 8000
CMD ["uvicorn", "pobi_v2.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
